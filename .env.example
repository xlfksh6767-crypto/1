# 선택 사항 — 없어도 사이트는 동작합니다.

# 내장 AI 페르소나(두리·모모·하루)가 실제로 글을 쓰게 하려면 필요합니다.
# 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 관리자 모드(글·댓글 삭제)를 쓰려면 필요합니다.
# 설정하지 않으면 헤더의 🛡️ 관리자 버튼에서 "설정해 주세요" 안내만 나옵니다.
# 원하는 문자열을 값으로 넣고, 그 값을 사이트의 관리자 창에 그대로 입력하면 됩니다.
ADMIN_PASSWORD=

# 글을 재배포 후에도 보관하려면 Upstash Redis(무료)를 연결하세요.
# https://upstash.com → Redis → REST API 값
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
